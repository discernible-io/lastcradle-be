{
  "openapi": "3.0.0",
  "info": {
    "title": "RODiT Authentication API",
    "version": "1.0.0",
    "description": "# API using Discernible Authentication system\n\n## Service Description\nThe RODiT Authentication API provides secure authentication services using the Discernible Authentication system. This API enables applications to implement robust user authentication, session management, and access control using RODiT's cryptographic identity verification.\n\n## Key Features\n- Secure user authentication via RODiT credentials\n- Session management and token-based authorization\n- User identity verification\n- Access control for protected resources\n- Metrics and monitoring capabilities\n\n## Data Handling and Privacy\nAll user data is handled in accordance with our privacy policy. We implement industry-standard encryption for data in transit and at rest. Personal information is processed only for the purposes of authentication and is not shared with third parties without explicit consent.\n\nWe comply with applicable data protection regulations including GDPR and CCPA. In the event of a data breach, we will notify affected users within 72 hours of discovery.",
    "termsOfService": "https://api.discernible.io/terms",
    "contact": {
      "name": "Discernible Inc.",
      "url": "https://api.discernible.io/home.js",
      "email": "support@rodit-tech.com"
    },
    "license": {
      "name": "Proprietary",
      "url": "https://api.discernible.io/license"
    },
    "x-api-id": "rodit-auth-api-v1"
  },
  "servers": [
    {
      "url": "https://api.discernible.io:9443",
      "description": "Production RODiT API Server"
    },
    {
      "url": "https://localhost:8080",
      "description": "Local development server"
    }
  ],
  "externalDocs": {
    "description": "Additional API Documentation",
    "url": "https://docs.rodit-tech.com"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token obtained after successful authentication"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message"
          },
          "requestId": {
            "type": "string",
            "description": "Unique request identifier"
          }
        },
        "required": ["error", "requestId"]
      },
      "LoginRequest": {
        "type": "object",
        "required": ["roditid", "roditid_base64url_signature"],
        "properties": {
          "roditid": {
            "type": "string",
            "description": "RODiT ID for authentication",
            "example": "01K43ASJTMA4V81C46WCRADGVD"
          },
          "timestamp": {
            "type": "integer",
            "description": "Current timestamp (optional)",
            "example": 1704067200
          },
          "roditid_base64url_signature": {
            "type": "string",
            "description": "Base64URL encoded signature",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Authentication success status"
          },
          "token": {
            "type": "string",
            "description": "JWT authentication token"
          },
          "requestId": {
            "type": "string",
            "description": "Unique request identifier"
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Comment ID"
          },
          "title": {
            "type": "string",
            "description": "Comment title"
          },
          "content": {
            "type": "string",
            "description": "Comment content"
          }
        },
        "required": ["title", "content"]
      },
      "CommentRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Comment title",
            "example": "Sample Comment"
          },
          "content": {
            "type": "string",
            "description": "Comment content",
            "example": "This is a sample comment content."
          }
        },
        "required": ["title", "content"]
      },
      "CommentUpdateRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Comment ID to update"
          },
          "title": {
            "type": "string",
            "description": "Updated comment title"
          },
          "content": {
            "type": "string",
            "description": "Updated comment content"
          }
        },
        "required": ["id"]
      },
      "CommentIdRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Comment ID"
          }
        },
        "required": ["id"]
      },
      "EchoRequest": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Message to echo",
            "example": "Hello, World!"
          }
        },
        "required": ["message"]
      },
      "EchoResponse": {
        "type": "object",
        "properties": {
          "echo": {
            "type": "string",
            "description": "Echoed message in uppercase"
          },
          "requestId": {
            "type": "string",
            "description": "Unique request identifier"
          }
        }
      },
      "RoditInfo": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Unique request identifier"
          },
          "config": {
            "type": "object",
            "description": "RODiT configuration object"
          }
        }
      },
      "TokenClaims": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Unique request identifier"
          },
          "user": {
            "type": "object",
            "description": "User claims from JWT token"
          }
        }
      }
    }
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Welcome page",
        "description": "Returns information about available endpoints",
        "tags": ["Public"],
        "responses": {
          "200": {
            "description": "Welcome message and endpoint information",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "This is the homepage request"
                }
              }
            }
          }
        }
      }
    },
    "/home": {
      "get": {
        "summary": "Homepage",
        "description": "Returns the homepage content",
        "tags": ["Public"],
        "responses": {
          "200": {
            "description": "Homepage content",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "example": "This is the homepage request"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "User login",
        "description": "Authenticate using RODiT credentials",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/logout": {
      "post": {
        "summary": "User logout",
        "description": "Invalidate the current session",
        "tags": ["Authentication"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Logout successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/echo/echo": {
      "post": {
        "summary": "Echo service",
        "description": "Echo the provided message in uppercase (requires authentication)",
        "tags": ["Protected"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EchoRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Echo response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cruda/create": {
      "post": {
        "summary": "Create comment",
        "description": "Create a new comment (requires authentication and permissions)",
        "tags": ["CRUD Operations"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Comment created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Comment"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "requestId": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request - missing title or content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },

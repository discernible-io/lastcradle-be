    "/api/logout": {
      "post": {
        "summary": "User logout",
        "description": "Invalidates the current session. Uses authenticateForLogout so expired JWTs may still be accepted when the signature is valid.",
        "tags": ["Authentication"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "responses": {
          "200": { "description": "Logout successful" },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json when body is sent",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "500": {
            "description": "Logout failed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "API health and dependency probes",
        "description": "Returns JSON from the Node.js API (`status`: `healthy` or `degraded`, `checks` for NEAR RPC and RODiT auth client). Nginx proxies `/health` to this handler (no separate edge stub). Results are cached per `HEALTH_CHECKS_CACHE_MS`.",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Health payload (may be degraded while process is up)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "enum": ["healthy", "degraded"] },
                    "degraded": { "type": "boolean" },
                    "checks": { "type": "object" },
                    "service": { "type": "string" },
                    "timestamp": { "type": "string", "format": "date-time" },
                    "instance": {
                      "type": "object",
                      "properties": {
                        "hostname": { "type": "string" },
                        "pid": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/token/claims": {
      "get": {
        "summary": "Inspect current JWT token claims",
        "description": "Returns the authenticated user's JWT claims as parsed and validated by the SDK middleware.\nUseful for debugging authentication issues and understanding token contents.",
        "tags": ["Authentication", "Debug"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current user claims from JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "requestId": {
                      "type": "string",
                      "format": "ulid"
                    },
                    "user": {
                      "type": "object",
                      "description": "Decoded JWT claims",
                      "properties": {
                        "sub": {
                          "type": "string",
                          "description": "Subject (user ID)"
                        },
                        "aud": {
                          "type": "string",
                          "description": "Audience"
                        },
                        "iss": {
                          "type": "string",
                          "description": "Issuer"
                        },
                        "exp": {
                          "type": "integer",
                          "description": "Expiration timestamp"
                        },
                        "iat": {
                          "type": "integer",
                          "description": "Issued at timestamp"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required or token invalid",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/login/timestamp": {
      "get": {
        "summary": "Login challenge timestamp",
        "description": "Returns synchronized Unix seconds and canonical ISO-8601 timestamp for constructing the login signing payload.",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "Challenge pair",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["timestamp", "timestamp_iso", "requestId"],
                  "properties": {
                    "timestamp": { "type": "integer" },
                    "timestamp_iso": { "type": "string", "format": "date-time" },
                    "requestId": { "type": "string" }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Failed to generate challenge",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "RODiT client login",
        "description": "Ed25519 challenge-response login. Signed payload is `identifier + timestamp_iso` (no separator). Provide exactly one of `timestamp` or `timestamp_iso` from the same GET /api/login/timestamp response.",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": ["roditid", "base64url_signature"],
                    "properties": {
                      "roditid": { "type": "string" },
                      "timestamp": { "type": "integer" },
                      "timestamp_iso": { "type": "string", "format": "date-time" },
                      "base64url_signature": { "type": "string" }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["roditid", "roditid_base64url_signature"],
                    "properties": {
                      "roditid": { "type": "string" },
                      "timestamp": { "type": "integer" },
                      "timestamp_iso": { "type": "string", "format": "date-time" },
                      "roditid_base64url_signature": { "type": "string" }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "headers": {
              "New-Token": {
                "description": "Same JWT as jwt_token in body",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["jwt_token", "requestId"],
                  "properties": {
                    "jwt_token": { "type": "string" },
                    "requestId": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid login payload or timestamp",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          },
          "401": {
            "description": "Authentication failed (when SILENT_LOGIN_FAILURES is false)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorResponse" }
              }
            }
          }
        }
      }
    },

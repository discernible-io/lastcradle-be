{
  "name": "@cableguard/rodit-sdk",
  "version": "1.0.0",
  "description": "JavaScript sdk for interacting with RODiT authentication and API services",
  "main": "roditclient.js",
  "scripts": {
    "test": "node ../src/run-tests.js --module=sdk-tests",
    "lint": "eslint .",
    "docs": "jsdoc -c jsdoc.json"
  },
  "keywords": [
    "rodit",
    "authentication",
    "api",
    "sdk",
    "cableguard"
  ],
  "author": "Ayayai",
  "license": "UNLICENSED",
  "dependencies": {
    "bs58": "^5.0.0",
    "ipaddr.js": "^2.0.1",
    "jose": "^4.14.4",
    "tweetnacl": "^1.0.3",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "eslint": "^8.40.0",
    "jsdoc": "^4.0.2"
  },
  "files": [
    "roditclient.js",
    "utils.js",
    "lib/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cableguard/rodit-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/cableguard/rodit-sdk/issues"
  },
  "homepage": "https://github.com/cableguard/rodit-sdk#readme"
}
